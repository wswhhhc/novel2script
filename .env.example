# Backend - AI 配置
ENABLE_AI_GENERATION=false
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4000
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=2
AUTO_FIX_ATTEMPTS=3

# Backend - 存储
NOVEL2SCRIPT_DB_PATH=backend/data/novel2script.db

# Backend - CORS（逗号分隔，部署时必须改为实际域名）
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-production-domain.com

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MAX_FILE_SIZE=10485760
VITE_SUPPORTED_FORMATS=.txt,.md
